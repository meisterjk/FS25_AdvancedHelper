<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="advancedHelperPage">
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="advancedHelperMenuHeaderIcon" size="50px 50px"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="categoryHeaderText" text="$l10n_advancedHelper_title" size="500px 32px"/>
        </GuiElement>

        <BoxLayout profile="fs25_subCategorySelectorTabbedBox" id="subCategoryBox">
        </BoxLayout>
        <ThreePartBitmap profile="fs25_lineSeparatorTopHighlighted" position="0px -57px"/>
        <MultiTextOption profile="fs25_subCategorySelectorTabbed" id="subCategoryPaging"
            position="0px -10px" onClick="updateSubCategoryPages"/>

        <!-- Sub-Tab Button Prefab (wird geklont pro Kategorie) -->
        <Button profile="fs25_subCategorySelectorTabbedTab" id="selectorPrefab">
            <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
        </Button>

        <!-- Bewerber-Inhalt (direkt, kein Prefab) -->
        <GuiElement profile="fs25_subCategorySelectorTabbedContainer" id="applicantsContent" visible="false">
            <GuiElement id="applicantsTableContainer">
                <GuiElement profile="fs25_statisticsHeaderBox">
                    <Button profile="advancedHelperHeader" position="40px 0px" text="$l10n_advancedHelper_name" handleFocus="false"/>
                    <Button profile="advancedHelperHeader" position="240px 0px" text="$l10n_advancedHelper_efficiency" handleFocus="false"/>
                    <Button profile="advancedHelperHeader" position="440px 0px" text="$l10n_advancedHelper_driving" handleFocus="false"/>
                    <Button profile="advancedHelperHeader" position="640px 0px" text="$l10n_advancedHelper_skill" handleFocus="false"/>
                    <Button profile="advancedHelperHeaderRight" position="840px 0px" size="200px 32px" text="$l10n_advancedHelper_salary" handleFocus="false"/>
                </GuiElement>

                <SmoothList profile="advancedHelperTable" id="applicantsTable" position="0px -40px">
                    <ListItem profile="advancedHelperListItem">
                        <Text profile="advancedHelperRowCellLeft" position="40px 0px" size="200px 32px" name="name"/>
                        <Text profile="advancedHelperRowCellLeft" position="240px 0px" size="200px 32px" name="efficiency"/>
                        <Text profile="advancedHelperRowCellLeft" position="440px 0px" size="200px 32px" name="driving"/>
                        <Text profile="advancedHelperRowCellLeft" position="640px 0px" size="200px 32px" name="skill"/>
                        <Text profile="advancedHelperRowCellRight" position="840px 0px" size="200px 32px" name="salary"/>
                    </ListItem>
                </SmoothList>

                <ThreePartBitmap profile="advancedHelperSliderBox" position="28px -40px" size="6px 670px">
                    <Slider profile="fs25_listSlider" dataElementId="applicantsTable"/>
                </ThreePartBitmap>
            </GuiElement>

            <GuiElement id="noApplicantsContainer">
                <Text profile="dialogTitle" text="$l10n_advancedHelper_noApplicants" position="0px -40px"/>
            </GuiElement>
        </GuiElement>

        <!-- Angestellten-Inhalt (direkt, kein Prefab) -->
        <GuiElement profile="fs25_subCategorySelectorTabbedContainer" id="employeesContent" visible="false">
            <GuiElement id="employeesTableContainer">
                <GuiElement profile="fs25_statisticsHeaderBox">
                    <Button profile="advancedHelperHeader" position="40px 0px" text="$l10n_advancedHelper_name" handleFocus="false"/>
                    <Button profile="advancedHelperHeader" position="240px 0px" text="$l10n_advancedHelper_efficiency" handleFocus="false"/>
                    <Button profile="advancedHelperHeader" position="440px 0px" text="$l10n_advancedHelper_driving" handleFocus="false"/>
                    <Button profile="advancedHelperHeader" position="640px 0px" text="$l10n_advancedHelper_skill" handleFocus="false"/>
                    <Button profile="advancedHelperHeaderRight" position="840px 0px" size="200px 32px" text="$l10n_advancedHelper_salary" handleFocus="false"/>
                </GuiElement>

                <SmoothList profile="advancedHelperTable" id="workersTable" position="0px -40px">
                    <ListItem profile="advancedHelperListItem">
                        <Text profile="advancedHelperRowCellLeft" position="40px 0px" size="200px 32px" name="name"/>
                        <Text profile="advancedHelperRowCellLeft" position="240px 0px" size="200px 32px" name="efficiency"/>
                        <Text profile="advancedHelperRowCellLeft" position="440px 0px" size="200px 32px" name="driving"/>
                        <Text profile="advancedHelperRowCellLeft" position="640px 0px" size="200px 32px" name="skill"/>
                        <Text profile="advancedHelperRowCellRight" position="840px 0px" size="200px 32px" name="salary"/>
                    </ListItem>
                </SmoothList>

                <ThreePartBitmap profile="advancedHelperSliderBox" position="28px -40px" size="6px 670px">
                    <Slider profile="fs25_listSlider" dataElementId="workersTable"/>
                </ThreePartBitmap>
            </GuiElement>

            <GuiElement id="noEmployeesContainer">
                <Text profile="dialogTitle" text="$l10n_advancedHelper_noEmployees" position="0px -40px"/>
            </GuiElement>
        </GuiElement>

        <!-- Bottom Panel (immer sichtbar) -->
        <GuiElement profile="fs25_bottomPanel" position="0px -720px">
            <Text profile="fs25_infoText" id="helpersCountText" text="" position="40px 0px"/>
            <Text profile="advancedHelperInfoTextBold" id="totalCostsValue" text="" position="400px 0px"/>
        </GuiElement>
    </GuiElement>
</GUI>